# MailArchive — variables de entorno (EJEMPLO)
# Copiar a `.env` y completar valores reales.
# NUNCA subir el archivo `.env` a GitHub.

# --- App ---
APP_NAME=MailArchive
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:5175
API_URL=http://localhost:18100
BIND_HOST=0.0.0.0
BIND_PORT=18100
SECRET_KEY=change-me-to-a-long-random-string

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Database ---
DB_ENGINE=sqlite
# mysql | sqlite — en prod usar mysql + docker-compose
# --- Database (MySQL) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mailarchive
MYSQL_PASSWORD=change-me-db-password
MYSQL_DATABASE=mailarchive

# --- Encryption at rest (tokens OAuth / passwords IMAP) ---
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=change-me-fernet-key

# --- Storage local ---
STORAGE_ROOT=./storage

# --- SMTP (invite / reset links) ---
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# --- Microsoft Graph / OAuth (sin secretos reales en git) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:18100/api/v1/accounts/microsoft/oauth/callback
MICROSOFT_OBJECT_ID=
MICROSOFT_SECRET_ID=
MICROSOFT_SCOPES=openid profile offline_access User.Read Mail.ReadWrite MailboxSettings.Read

# --- Public self-register (login → Crear usuario). Off by default. ---
FEATURE_PUBLIC_REGISTER=false

# --- Rate limiting (login / register / install) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Install ---
# Solo usado como hints de bootstrap; la UI pide los valores al instalar
INSTALL_TENANT_NAME=Acme
INSTALL_TENANT_SLUG=acme
INSTALL_ADMIN_EMAIL=admin@example.com
INSTALL_ADMIN_NAME=Administrator

CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
