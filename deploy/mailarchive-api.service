[Unit]
Description=MailArchive API (FastAPI / uvicorn)
After=network-online.target mnt-almacen.mount
Wants=network-online.target
RequiresMountsFor=/mnt/almacen/apps/produccion/m365_archivo

[Service]
Type=simple
User=pablo
Group=pablo
WorkingDirectory=/mnt/almacen/apps/produccion/m365_archivo/backend
EnvironmentFile=-/mnt/almacen/apps/produccion/m365_archivo/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/mnt/almacen/apps/produccion/m365_archivo/backend
# Un solo worker: los archive jobs viven en threads in-memory del proceso
ExecStart=/mnt/almacen/apps/produccion/m365_archivo/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 18100 --workers 1
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mailarchive-api

[Install]
WantedBy=multi-user.target
