[Unit]
Description=MailArchive Frontend (Vite preview — production build)
After=network-online.target mailarchive-api.service
Wants=network-online.target

[Service]
Type=simple
User=__MAILARCHIVE_USER__
Group=__MAILARCHIVE_USER__
WorkingDirectory=__MAILARCHIVE_ROOT__/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 5175 --strictPort
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mailarchive-frontend

[Install]
WantedBy=multi-user.target
